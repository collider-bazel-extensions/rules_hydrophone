load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":toolchain.bzl", "current_hydrophone_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files(["toolchain.bzl"])

toolchain_type(name = "hydrophone")

# The resolved hydrophone + kubectl for the target platform, usable as `data`.
current_hydrophone_toolchain(name = "current")

# Per-platform toolchains. Each `hydrophone_<plat>` repo (created by the
# module extension) holds one platform's binaries and its toolchain
# implementation, at whichever version the extension resolved.

toolchain(
    name = "hydrophone_linux_amd64",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchain = "@hydrophone_linux_amd64//:toolchain_impl",
    toolchain_type = ":hydrophone",
)

toolchain(
    name = "hydrophone_linux_arm64",
    exec_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    toolchain = "@hydrophone_linux_arm64//:toolchain_impl",
    toolchain_type = ":hydrophone",
)

toolchain(
    name = "hydrophone_darwin_amd64",
    exec_compatible_with = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    toolchain = "@hydrophone_darwin_amd64//:toolchain_impl",
    toolchain_type = ":hydrophone",
)

toolchain(
    name = "hydrophone_darwin_arm64",
    exec_compatible_with = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    toolchain = "@hydrophone_darwin_arm64//:toolchain_impl",
    toolchain_type = ":hydrophone",
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = ["//private:providers"],
)
